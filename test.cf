

struct Point {
    var x::int;
    var y::int;


    func __init__(self,x,y){
        self.x = x
        self.y = y
        return 0;
    }

    func __str__(self){
        return self.x + " " + self.y
    }


    func __self__(self){
        return self
    }

}



var p = new Point(0,1);
var m = p.__self__()


p.x = 89
m.x = 78




println(p)
println(m)
