
const DEBUG = true;



if DEBUG == true{
    println("Nous Sommes en mode Debug !")
}


struct Point{
    var i = 0;
    var j = 0;

    var other = DEBUG;
    func __init__(x,y){
        i = x
        j = y
    }
}

const newPoint = new Point(21,22);
newPoint.other = false;
println(newPoint.other)

