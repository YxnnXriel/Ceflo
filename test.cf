

func patron10(m, n){
    var l = "";

    for var i = 0; i < m ; i+=1 {
        l += '.'
    }

    for var i = 0 ; i < n ; i+=1 {
        if (i+1 )% 10 == 0 or i == 0 {
            if i == 0{
                l += @str(0)
            }else{
                l += @str(i+1)
            }
        }else{
            l += '+';
        }
    }

    println(l)
}


patron10(10, 23)