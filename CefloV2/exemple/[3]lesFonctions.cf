/*

    comme pour les variables, les fonction peuvent retourner n importe qu elle valeur (des mise à jour seront disponible pour gerer les donners).
    Voici des exemples de declaration de fonctions et d appel de fonction :
*/


// une procedure
func hello(){
    println("Hello !")
}

// appel de la procédure
hello()


// une fonction
func return2(){
    return '2';
}


println("la fonction return2 retourne : ",return2());


func add(a,b){
    return a+b;
}

println(add(1,2));

// oui oui !!
println(add("j'ai ",2) ," pains");

