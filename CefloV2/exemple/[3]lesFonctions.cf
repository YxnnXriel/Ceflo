/*

    Comme pour les variables, les fonctions peuvent retourner n importe quelle valeur (des mises à jour seront disponibles pour gérer les données).
    Voici des exemples de déclaration de fonctions et d appel de fonction :
*/


// une procedure
func hello(){
    println("Hello !")
}

// appel de la procédure
hello()


// une fonction
func return2(){
    return '2';
}


println("la fonction return2 retourne : ",return2());


func add(a,b){
    return a+b;
}

println(add(1,2));

// oui oui !!
println(add("j'ai ",2) ," pains"); //  ==>  j'ai 2 pains

