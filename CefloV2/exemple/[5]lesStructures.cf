/*
    La déclaration d une structure se fait comme suite :
*/


struct maStructure {
    var l
}

// simplement !!


// Avec la clé new, on peut créer une instance de structure
var structure = new maStructure();





/*
    On peut créer un crée une fonction qui va nous aider à initialiser les variables 
    de la structure un peu comme un constructeur ou on peut directement donner des valeurs par défaut.
    Voici deux exemples de structure :
*/

// Initialiser avec des valeurs par défaut
struct Personnage{
    var Nom = "Tim"
    var PointDeVie = 100
    var Attack = 12
    var Defense = 7
}

// avec "constructeur"

struct Article{
    var Nom_Article;
    var Prix
    var Qte


    // la fonction __init__ sera appeler pour initialiser chaque variable
    func __init__(nom,prix,qte){
        Nom_Article = Nom_Article
        Prix = prix
        Qte = qte
    }

}


var P1 = new Personnage(); // Tous les champs de P1 seront par défaut tous les éléments initialisés de base dans la structure Personnage.

var Art1 = new Article("Pomme de terre",1500,3); // Le constructeur va initialiser les valeurs avec les données passées en argument.








/*
    Comment afficher le tous ?
- vous pouvez définir une fonction qui sera appelée lors de l affichage
- vous pouvez afficher chaque valeur vous-même en précisant son attribut avec '.'
    exemples :
*/



struct MaDeuxiemeStructure{
    var T = "MaDeuxiemeStructure"

    // Elle sera appelée pour afficher la structure
    func __str__(){
        return T;
    }
}

var t = new MaDeuxiemeStructure()


println(t) // ==> MaDeuxiemeStructure


println(Art1.Nom_Article) // ==> Pomme de terre




