{

	"Print to console": {
		"prefix": "log",
		"body": [
			"console.log('$1');",
			"$2"
		],
		"description": "Log output to console"
	},
	"define variable": {
		"prefix": "var",
		"body": [
			"var ${1:variable_name} = ${2:value}",
			"$3"
		],
		"description": "Log output to console"
	},
	"define variable with type" :{
		"prefix": "var",
		"body" : [
			"var ${1:variable_name}::${2:type} = ${3:value};",
			"$4"
		]
	},
	"define function definition":{
		"prefix": "func",
		"body" :[
			"func ${1:function_name}(${2:args}) {",
				"\tprintln(${2});",
			"}"
		]
	},
	"define function definition_without_args":{
		"prefix": "func",
		"body" :[
			"func ${1:function_name}{",
				"\tprintln(\"${2}\");",
			"}"
		]
	},
	"define function definition_arrow":{
		"prefix": "func",
		"body" :[
			"func ${1:function_name} -> ${2:arg1}, ${3:args2} {",
				"\tprintln(${2} ,\" can do\");",
				"\tprintln(${3} ,\" can do\");",
			"}"
		]
	},
	"define function definition_arrow_with_return_type":{
		"prefix": "func",
		"body" :[
			"func ${1:function_name} -> ${2:arg1}, ${3:args2} : ${4:type} {",
				"\tprintln(${2} ,\" can do\");",
				"\tprintln(${3} ,\" can do\");",
				"\treturn none",
			"}"
		]
	},

	"define function definition_arrow_with_return_type_without_args":{
		"prefix": "func",
		"body" :[
			"func ${1:function_name} -> : ${2:type}{",
				"\tprintln(\"you are the best :) don't cry ! \");",
				"\treturn ${3:give}",
			"}"
		]
	},
	"define struct_definition":{
		"prefix": "struct",
		"body" :[
			"struct ${1:type}{",
			"\tvar ${2:variable_name}::${3:type};\n",
			"\tfunc __init__(self,${2:variable_name}){",
			"\t\tself.${2:variable_name} = 0",
			"\t}",
			"\n\tfunc __str__(self){",
			"\t\treturn self.${2:variable_name}",
			"\t}",
			"}"
		]
	},
	"define_println":{
		"prefix": "println",
		"body" :[
			"println(\"$1\");",
			"$2"
		]
	},
	"define_input":{
		"prefix": "input",
		"body" :[
			"${1:variable} = input(\"$2\");",
			"$3"
		]
	}
}