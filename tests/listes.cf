var l = [1, 2, "x", 'c', none, true, [], [1]]
println(l)
println([])
println(l.lenght(), " ", l.length(), " ", l[2], " ", l[7][0])

// Une liste est une référence
var a = [1]
var b = a
b.append(2)
println(a)
func ajoute(liste){ liste.append("par ref") }
ajoute(a)
println(a)

// Un littéral crée une nouvelle liste à chaque passage
func neuve(){ var n = [1]; n.append(2); return n }
println(neuve(), neuve())

// Modifier
var m = [1, 2, 3]
m[0] = "z"
m[1] += 5
m[2] *= 2
println(m)
m.append(7, 8)
println(m.remove(0), " ", m)
println(m.get(0), " ", m.get(99))
println([1] + [2, 3], " ", [1, [2]] == [1, [2]], " ", [1] == [2], " ", [1] != [1, 1])
println([1, 2, 3, 4].filter(lfunc(x){ return x % 2 == 0 }))
var grille = [[0, 0], [0, 0]]
grille[1][0] = 5
println(grille)

// L'index de `+=` n'est calculé qu'une fois
var appels = 0
func idx(){ appels += 1; return 0 }
var v = [10]
v[idx()] += 1
println(v, " ", appels)

// Une liste qui se contient s'affiche sans boucler
var moi = [1]
moi.append(moi)
println(moi)

// Chaînes
var s = "abc"
println(s[0], " ", s.lenght(), " ", s[0] == 'a')
var t = s
t[0] = 'X'
println(s, " ", t)
t[1] = 89
println(t)
var ls = ["abc"]
ls[0][2] = '!'
println(ls)
func mute(){ var c = "abc"; c[0] = 'Z'; return c }
println(mute(), mute())
println("{} a {} ans {".format("Yann", 21))
println("a,b,,c".split(","), " ", "abc".split(","))
println(format("Hi ${s} ${1 + 1} ${[1].lenght()} \${x}"))
var h = "h"
func f_local(){ var h = "local"; return format("${h}") }
println(f_local())
printf("printf ${h}\n")
for var i = 0; i < 3; i += 1 { print(format("${i};")) }
println()
println([1].get(1000000000000000000000), " ", @char(321), " ", @char(1000000000000000000000) == '\0')
