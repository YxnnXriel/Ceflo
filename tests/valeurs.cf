// Un calcul ne modifie jamais ses opérandes
var x = 5
var y = -x
println(x, " ", y)
func moins_un(){ var a = -1; return a }
println(moins_un(), moins_un(), moins_un())

// Priorités
println(1 + 2 * 3, " ", (1 + 2) * 3, " ", 10 - 2 - 3, " ", 7 % 3, " ", 7.5 % 2)
println(1 + 1 == 2 and 2 < 3)
println(false or true and false)
println(!true, " ", !0, " ", !"", " ", -(-3))

// Vérité
println(!!1, !!-1, !!0, !!"a", !!"", !![], !![1], !!none, !!'a')

// and / or s'arrêtent dès que le résultat est connu
func boom(){ println("BOOM"); return true }
println(false and boom(), " ", true or boom())

// Affichage des nombres
println(1000000, " ", 1234567.5, " ", 0.1 + 0.2, " ", -2.5, " ", 100000000000)

// Chaînes
println("a" + 1 + true + (2 + 3), " ", 1 + "a", " ", "ab" * 3, "|", "ab" * 0, "|")
println("x" == "x", " ", "x" != "y", " ", "a" < "b", " ", "abc" >= "abd")
println("guillemets \"ok\"\ttab\\")
println('A' == "A", " ", 'A' == 65, " ", 'A' + 1, " ", @char('A' + 1), " ", 'a' < 'b')
println("\n".lenght())

// none
var rien = none
println(rien, " ", rien == none, " ", 1 == none, " ", rien != none)

// Ternaire
println(3 > 2 ? "oui" : "non", " ", false ? 1 : 2, " ", 1 > 2 ? 1 : 3 > 2 ? 2 : 3, " ", false ? 1)

/* commentaire ** avec des * */ println("après le commentaire") // fin
/**/ println("vide")
var a = 1, b = 2; println(a + b)
const K = 3
println(K * 2)
