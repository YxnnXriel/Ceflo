{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CeFlo",
  "scopeName": "source.cf",

  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-definition" },
    { "include": "#variable-definition" },
    { "include": "#struct-definition" },
    { "include": "#parameters" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#reserved-words" },
    { "include": "#property-access" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#number" },
    { "include": "#annotations" },
    { "include": "#variable-reference" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.ceflo", "match": "//.*$" },
        { "name": "comment.block.ceflo", "begin": "/\\*", "end": "\\*/" }
      ]
    },

    "function-definition": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.ceflo" },
            "2": { "name": "entity.name.function.definition.ceflo" }
          }
        }
      ]
    },

    "variable-definition": {
      "patterns": [
        {
          "match": "\\b(var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.ceflo" },
            "2": { "name": "variable.other.definition.ceflo" }
          }
        }
      ]
    },

    "struct-definition": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.struct.ceflo" },
            "2": { "name": "entity.name.type.struct.ceflo" }
          }
        }
      ]
    },

    "parameters": {
      "patterns": [
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*(bool|char|int|float|str|lfunc)\\b",
          "captures": {
            "1": { "name": "variable.parameter.ceflo" },
            "2": { "name": "keyword.type.ceflo" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        { "name": "keyword.control.ceflo", "match": "\\b(if|else|while|for|return|break|continue|var|func)\\b" },
        { "name": "keyword.operator.word.ceflo", "match": "\\b(and|or)\\b" },
        { "name": "keyword.control.preprocessor.ceflo", "match": "\\b(from|import|export)\\b" },
        { "name": "keyword.control.switch.ceflo", "match": "\\b(switch|case|default)\\b" },
        { "name": "keyword.control.new.ceflo", "match": "\\bnew\\b" },
        { "name": "variable.language.ceflo", "match": "\\bself\\b" },
        { "name": "keyword.control.struct.ceflo", "match": "\\bstruct\\b" }
      ]
    },

    "types": {
      "patterns": [
        { "name": "keyword.type.ceflo", "match": "\\b(bool|char|int|float|str|lfunc)\\b" }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "constant.language.ceflo", "match": "\\b(true|false|none)\\b" }
      ]
    },

    "reserved-words": {
      "patterns": [
        { "name": "entity.name.function.builtin.ceflo", "match": "\\b(println|print|input|printf)\\b" },
        { "name": "entity.name.function.special.ceflo", "match": "\\b(__init__|__str__)\\b" }
      ]
    },

    "property-access": {
      "patterns": [
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.method.ceflo" } }
        },
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": { "1": { "name": "variable.other.property.ceflo" } }
        }
      ]
    },

    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.ceflo" } }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ceflo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.ceflo",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.ceflo" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.ceflo" } },
              "patterns": [{ "include": "$self" }]
            },
            { "name": "constant.character.escape.ceflo", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.ceflo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "meta.interpolation.ceflo",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.ceflo" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.ceflo" } },
              "patterns": [{ "include": "$self" }]
            },
            { "name": "constant.character.escape.ceflo", "match": "\\\\." }
          ]
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.ceflo", "match": "%=|\\+=|-=|\\*=|/=|=" },
        { "name": "keyword.operator.comparison.ceflo", "match": "!=|<=|>=|==|<|>" },
        { "name": "keyword.operator.logical.ceflo", "match": "&&|\\|\\||::|@" },
        { "name": "keyword.operator.arithmetic.ceflo", "match": "%|\\*|/|-|\\+" }
      ]
    },

    "number": {
      "patterns": [
        { "name": "constant.numeric.ceflo", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    },

    "annotations": {
      "patterns": [
        { "name": "meta.annotation.ceflo", "match": "@[a-zA-Z_][a-zA-Z0-9_]*(\\(\\))?" }
      ]
    },

    "variable-reference": {
      "patterns": [
        { "name": "variable.other.ceflo", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" }
      ]
    }
  }
}