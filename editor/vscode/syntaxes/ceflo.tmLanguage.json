{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "CeFlo",
	"scopeName": "source.cf",

	"patterns": [
		{ "include": "#keywords" },
		{ "include": "#strings" },
		{ "include": "#reserved-words" },
		{ "include": "#operators" },
		{ "include": "#number" },
		{ "include": "#types" },
		{ "include": "#function-definition" },
		{ "include": "#annotations" },

		{
			"name": "constant.character.interpolation.ceflo",
			"match": "\\$\\{[^}]+\\}"
		}
	],

	"repository": {

		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.ceflo",
					"match": "\\b(if|else|match|case|while|for|in|return|break|continue|var|const|func)\\b"
				},
				{
					"name": "comment.line.ceflo",
					"match": "//.*$"
				},
				{
					"name": "comment.block.ceflo",
					"begin": "/\\*",
					"end": "\\*/"
				},
				{
					"name": "keyword.operator.word.ceflo",
					"match": "\\b(and|or)\\b"
				},
				{
					"name": "keyword.type.ceflo",
					"match": "\\b(bool|char|int|float|number|str|string|list|map|lfunc)\\b"
				},
				{
					"name": "constant.language.ceflo",
					"match": "\\b(true|false|none)\\b"
				},
				{
					"name": "keyword.control.preprocessor.ceflo",
					"match": "\\b(from|import|export)\\b"
				},
				{
					"name": "keyword.control.new.ceflo",
					"match": "\\bnew\\b"
				},
				{
					"name": "variable.language.ceflo",
					"match": "\\bself\\b"
				},
				{
					"name": "keyword.control.struct.ceflo",
					"match": "\\bstruct\\b"
				},
				{
					"name": "keyword.control.enum.ceflo",
					"match": "\\benum\\b"
				}
			]
		},

		"strings": {
			"patterns": [

				{
					"name": "string.quoted.double.ceflo",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.ceflo",
							"match": "\\\\."
						}
					]
				},

				{
					"name": "string.quoted.single.ceflo",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.ceflo",
							"match": "\\\\."
						}
					]
				}
			]
		},

		"reserved-words": {
			"patterns": [
				{
					"name": "entity.name.function.builtin.ceflo",
					"match": "\\b(println|print|input|printf|format|nextInt|exit|argv)\\b"
				},
				{
					"name": "entity.name.function.special.ceflo",
					"match": "\\b(__init__|__str__|__cast__)\\b"
				},
				{
					"name": "entity.name.function.method.ceflo",
					"match": "\\.(lenght|length|append|remove|get|filter|print|format|split|set|has|keys|values)\\b"
				}
			]
		},

		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.ceflo",
					"match": "%=|\\+=|-=|\\*=|/="
				},
				{
					"name": "keyword.operator.comparison.ceflo",
					"match": "!=|<=|>=|==|<|>"
				},
				{
					"name": "keyword.operator.logical.ceflo",
					"match": "::|@|!"
				},
				{
					"name": "keyword.operator.arithmetic.ceflo",
					"match": "%|\\*|/|-|\\+"
				}
			]
		},

		"number": {
			"name": "constant.numeric.ceflo",
			"match": "\\b\\d+(\\.\\d+)?\\b"
		},

		"types": {
			"patterns": [
				{
					"name": "keyword.type.ceflo",
					"match": "\\b(bool|char|int|float|number|str|string|list|map|lfunc)\\b"
				}
			]
		},

		"function-definition": {
			"patterns": [
				{
					"name": "entity.name.function.ceflo",
					"match": "\\bfunc\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
				},
				{
					"name": "entity.name.function.call.ceflo",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
				}
			]
		},

		"annotations": {
			"patterns": [
				{
					"name": "meta.annotation.ceflo",
					"match": "@[a-zA-Z_][a-zA-Z0-9_]*"
				}
			]
		}
	}
}