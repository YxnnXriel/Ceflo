// Création d'objets, attributs et méthodes
struct Point {
    var x::number
    var y::number
    func __init__(x, y){ self.x = x; self.y = y }
    func ajoute(autre){ return new Point(x + autre.x, y + autre.y) }
}
var p = new Point(0, 0)
var un = new Point(1, 2)
for var i = 0; i < 1000000; i += 1 {
    p = p.ajoute(un)
}
println(p.x, " ", p.y)
