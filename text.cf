




struct List {
    var list;
    var lenght;

    func __init__(){
        list = [];
        lenght = 0;
    }
    func append(item){
        list.append(item);
        lenght += 1;
    }

    func __str__(){
        println(list);
        return lenght;
    }
}



var k = new List();
k.append(1)
println(k)

