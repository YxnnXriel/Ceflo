




struct List {
    var list;
    var lenght;

    func __init__(){
        list = [];
        lenght = 0;
    }

    func append(item){
        list.append(item);
        lenght += 1;
    }

    func get(item){
        return list.get(item);
    }
    func __str__(){
        println(list);
        return lenght;
    }
}



var k = new List();
var i = 0;

k.append(1)
k.append(2)
k.append(3)
k.append(9)
k.append("Yann Ariel")

println(k.get(3))



